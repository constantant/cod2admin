# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.
# See docs/PLAN.md §11 for what this backs.

# --- Telegram (use a separate dev bot/group, never the real admin one — §11.1) ---
TELEGRAM_BOT_TOKEN=REPLACE_WITH_DEV_BOT_TOKEN_FROM_BOTFATHER
# Optional (§4) — if unset, claim ownership instead via /claim <secret> using the secret the
# gateway prints on startup. Whichever happens first wins; leave unset to test /claim.
OWNER_TELEGRAM_ID=REPLACE_WITH_YOUR_TELEGRAM_USER_ID

# --- CoD2 dedicated server (docker-compose service `cod2_server`) ---
# Alias for the one `servers` row the gateway bootstraps from the COD2_RCON_* vars below on
# first startup (§7/§9 Phase 2). Optional — defaults to "default"; only worth changing once you
# have more than one server and want a more memorable /bindserver <alias>.
COD2_SERVER_ALIAS=default
COD2_RCON_HOST=127.0.0.1
COD2_RCON_PORT=28960
# Must match `rcon_password` in docker/cod2server/main/server_mp.cfg — kept in sync by hand.
COD2_RCON_PASSWORD=dev_rcon_password_change_me
# Host path of the bind-mounted games_mp.log (fs_homepath in docker-compose.yml), what
# log-tailer reads. NOT under docker/cod2server/main — that's fs_basepath (game data, named
# volume, not reachable from the host at all - docs/PLAN.md §11.1).
COD2_LOG_PATH=./docker/cod2server/homedir/main/games_mp.log
# Optional - how player names, chat, /say text and the log are encoded: cp1251 (default, for
# Russian servers) or latin1 (Western European). See docs/PLAN.md §2.4, "Text encoding".
COD2_TEXT_ENCODING=cp1251
# Optional - IP country labels (/players, report cards, /bans), from DB-IP's free country
# database, which the bot downloads and refreshes monthly. Set GEOIP_ENABLED=false to turn them
# off, or GEOIP_DB_PATH to a .mmdb you supply yourself (turns off the automatic download).
# GEOIP_ENABLED=true
# GEOIP_DB_PATH=
# Optional - routes to the Telegram Bot API (see docs/PLAN-russia-access.md). By default the bot
# tries api.telegram.org, then the project's shared relays. TELEGRAM_RELAYS (comma-separated)
# replaces the shared relays; TELEGRAM_DIRECT=false skips api.telegram.org. /relays in Telegram
# overrides both.
# TELEGRAM_RELAYS=https://my-relay.example
# TELEGRAM_DIRECT=true

# --- Postgres (docker-compose service `postgres`) ---
POSTGRES_USER=cod2admin
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_DB=cod2admin_dev
DATABASE_URL=postgres://cod2admin:dev_password_change_me@127.0.0.1:5432/cod2admin_dev

# --- Secrets encryption for rcon passwords etc. at rest (§7) ---
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
