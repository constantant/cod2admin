# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.
# See docs/PLAN.md §11 for what this backs.

# --- Telegram (use a separate dev bot/group, never the real admin one — §11.1) ---
TELEGRAM_BOT_TOKEN=REPLACE_WITH_DEV_BOT_TOKEN_FROM_BOTFATHER
OWNER_TELEGRAM_ID=REPLACE_WITH_YOUR_TELEGRAM_USER_ID

# --- CoD2 dedicated server (docker-compose service `cod2_server`) ---
COD2_RCON_HOST=127.0.0.1
COD2_RCON_PORT=28960
# Must match `rcon_password` in docker/cod2server/main/server_mp.cfg — kept in sync by hand.
COD2_RCON_PASSWORD=dev_rcon_password_change_me
# Host path of the bind-mounted games_mp.log (see docker-compose.yml), what log-tailer reads.
COD2_LOG_PATH=./docker/cod2server/main/games_mp.log

# --- Postgres (docker-compose service `postgres`) ---
POSTGRES_USER=cod2admin
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_DB=cod2admin_dev
DATABASE_URL=postgres://cod2admin:dev_password_change_me@127.0.0.1:5432/cod2admin_dev

# --- Secrets encryption for rcon passwords etc. at rest (§7) ---
SECRETS_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
