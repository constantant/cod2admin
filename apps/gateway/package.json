{
  "name": "@cod2admin/gateway",
  "version": "1.12.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "nx": {
    "name": "gateway",
    "targets": {
      "serve": {
        "dependsOn": [
          "build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node dist/main.js",
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@cod2admin/admin-store": "workspace:*",
    "@cod2admin/ban-store": "workspace:*",
    "@cod2admin/log-tailer": "workspace:*",
    "@cod2admin/rcon-client": "workspace:*",
    "@cod2admin/report-pipeline": "workspace:*",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "fastify": "^5.12.5",
    "grammy": "^1.46.0",
    "maxmind": "^5.0.7",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
