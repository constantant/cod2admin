# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

.claude/worktrees
.claude/settings.local.json
.nx/polygraph
.nx/self-healing
.nx/migrate-runs

# Local dev env (see .env.example) - never commit real secrets
.env

# CoD2 dev server game data - not redistributable, see docker/cod2server/README.md
docker/cod2server/main/*.iwd

# CoD2 dev server fs_homepath - runtime-generated logs/config/punkbuster state, see
# docker/cod2server/README.md and docs/PLAN.md §11.1
docker/cod2server/homedir/*
!docker/cod2server/homedir/.gitkeep
vitest.config.*.timestamp*

# npm lockfile - workspace uses pnpm (pnpm-lock.yaml), don't let a stray `npm install` add this back
package-lock.json

# scripts/build-installer-bundle.sh output - large build artifacts, not source
/out
installer/*.tar.gz
installer/*.tar.gz.sha256